---
// Shown when the CMS backend is unreachable (503). No CMS data required.
---

<div class="max-w-[1440px] mx-auto px-5 md:px-10 py-20 md:py-28 lg:py-36 text-center">
  <div class="max-w-[480px] mx-auto">

    <div class="w-16 h-16 bg-navy/5 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-8 h-8 text-navy/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
      </svg>
    </div>

    <h1 class="text-[28px] md:text-[34px] font-bold text-navy mb-3 leading-tight">
      We'll be back shortly
    </h1>
    <p class="text-[16px] md:text-[17px] text-muted leading-relaxed mb-8">
      This page is temporarily unavailable. Please try again in a few minutes.
    </p>

    <a
      href="/"
      class="inline-flex items-center gap-2 bg-teal text-white px-6 py-3 rounded-xl font-bold text-[15px] hover:bg-teal/90 transition-colors"
    >
      Return Home
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>

  </div>
</div>
