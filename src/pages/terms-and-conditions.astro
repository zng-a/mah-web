---
import Base from '../layouts/Base.astro';
---

<Base title="Terms & Conditions">
  <main class="max-w-[900px] mx-auto px-5 md:px-10 py-10 md:py-14 lg:py-20">

    <div class="text-center mb-10 lg:mb-14">
      <h1 class="text-[36px] md:text-[48px] lg:text-[56px] font-bold text-navy leading-tight mb-3">
        Terms &amp; Conditions
      </h1>
      <p class="text-[15px] md:text-[16px] text-muted">
        Last updated: March 2025
      </p>
    </div>

    <div class="prose-content space-y-8">

      <section class="bg-white rounded-[24px] border-2 border-navy/5 p-8 lg:p-10">
        <h2 class="text-[22px] lg:text-[24px] font-bold text-navy mb-4">1. About Us</h2>
        <p class="text-[15px] lg:text-[16px] text-muted leading-relaxed">
          This website is operated by <strong class="text-navy">Masjid Al-Hikmah</strong>, a charity registered in England and Wales (Charity No. 1041977). By accessing or using this website, you agree to these Terms & Conditions. If you do not agree, please do not use the website.
        </p>
        <div class="mt-4 p-4 bg-light-bg rounded-xl text-[15px] text-navy space-y-1">
          <p><strong>Email:</strong> <a href="mailto:info@masjidalhikmah.co.uk" class="text-teal hover:text-navy transition-colors">info@masjidalhikmah.co.uk</a></p>
          <p><strong>Phone:</strong> <a href="tel:02084722745" class="text-teal hover:text-navy transition-colors">020 8472 2745</a></p>
        </div>
      </section>

      <section class="bg-white rounded-[24px] border-2 border-navy/5 p-8 lg:p-10">
        <h2 class="text-[22px] lg:text-[24px] font-bold text-navy mb-4">2. Use of This Website</h2>
        <p class="text-[15px] lg:text-[16px] text-muted leading-relaxed mb-3">
          You may use this website for lawful purposes only. You must not:
        </p>
        <ul class="space-y-2 text-[15px] lg:text-[16px] text-muted">
          <li class="flex gap-2"><span class="text-teal font-bold mt-1">—</span><span>Use the website in any way that is unlawful or fraudulent</span></li>
          <li class="flex gap-2"><span class="text-teal font-bold mt-1">—</span><span>Transmit any unsolicited or unauthorised advertising material</span></li>
          <li class="flex gap-2"><span class="text-teal font-bold mt-1">—</span><span>Attempt to gain unauthorised access to any part of the website or its systems</span></li>
          <li class="flex gap-2"><span class="text-teal font-bold mt-1">—</span><span>Interfere with or disrupt the website's availability or security</span></li>
        </ul>
        <p class="text-[15px] lg:text-[16px] text-muted leading-relaxed mt-3">
          We reserve the right to restrict access to any part of this website without notice if these terms are breached.
        </p>
      </section>

      <section class="bg-white rounded-[24px] border-2 border-navy/5 p-8 lg:p-10">
        <h2 class="text-[22px] lg:text-[24px] font-bold text-navy mb-4">3. Donations</h2>

        <div class="space-y-5">
          <div>
            <h3 class="text-[17px] lg:text-[18px] font-semibold text-navy mb-2">3.1 General</h3>
            <p class="text-[15px] lg:text-[16px] text-muted leading-relaxed">
              All donations made through this website are voluntary contributions to Masjid Al-Hikmah. By making a donation, you confirm that you are the authorised holder of the payment method used.
            </p>
          </div>

          <div>
            <h3 class="text-[17px] lg:text-[18px] font-semibold text-navy mb-2">3.2 Use of Funds</h3>
            <p class="text-[15px] lg:text-[16px] text-muted leading-relaxed">
              All donations are used exclusively to support the charitable objectives of Masjid Al-Hikmah, including the maintenance and development of the masjid and its services. Specific campaign funds (e.g. building construction) will be applied to that stated purpose.
            </p>
          </div>

          <div>
            <h3 class="text-[17px] lg:text-[18px] font-semibold text-navy mb-2">3.3 Refunds</h3>
            <p class="text-[15px] lg:text-[16px] text-muted leading-relaxed">
              Donations are generally non-refundable once processed. If you believe a donation was made in error (e.g. a duplicate payment or technical issue), please contact us within 30 days at <a href="mailto:info@masjidalhikmah.co.uk" class="text-teal hover:text-navy transition-colors">info@masjidalhikmah.co.uk</a>. We will review each request individually at our discretion.
            </p>
          </div>

          <div>
            <h3 class="text-[17px] lg:text-[18px] font-semibold text-navy mb-2">3.4 Recurring Donations</h3>
            <p class="text-[15px] lg:text-[16px] text-muted leading-relaxed">
              If you set up a recurring (monthly) donation, payments will be taken automatically on a monthly basis. You may cancel at any time by contacting us at <a href="mailto:info@masjidalhikmah.co.uk" class="text-teal hover:text-navy transition-colors">info@masjidalhikmah.co.uk</a>. Cancellations will take effect before the next scheduled payment.
            </p>
          </div>

          <div>
            <h3 class="text-[17px] lg:text-[18px] font-semibold text-navy mb-2">3.5 Gift Aid</h3>
            <p class="text-[15px] lg:text-[16px] text-muted leading-relaxed">
              If you make a Gift Aid declaration, you confirm that you are a UK taxpayer and that you pay sufficient Income Tax or Capital Gains Tax to cover the Gift Aid claimed on your donation. It is your responsibility to notify us if your tax status changes. Making a false Gift Aid declaration is a criminal offence.
            </p>
          </div>
        </div>
      </section>

      <section class="bg-white rounded-[24px] border-2 border-navy/5 p-8 lg:p-10">
        <h2 class="text-[22px] lg:text-[24px] font-bold text-navy mb-4">4. Intellectual Property</h2>
        <p class="text-[15px] lg:text-[16px] text-muted leading-relaxed">
          All content on this website — including text, images, graphics, and design — is owned by or licensed to Masjid Al-Hikmah unless otherwise stated. You may not reproduce, distribute, or create derivative works from any content on this site without our prior written permission. You may share links to our pages freely.
